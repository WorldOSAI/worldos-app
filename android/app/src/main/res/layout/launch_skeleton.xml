<?xml version="1.0" encoding="utf-8"?>
<!-- Native launch skeleton (MainActivity): drawn on the first frame, over the WebView, until
     the remote page commits its first paint. Shapes follow the home page at phone width. -->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/launch_skeleton"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/launch_skeleton_background"
    android:clickable="true"
    android:focusable="true"
    android:importantForAccessibility="noHideDescendants">

    <LinearLayout
        android:id="@+id/launch_skeleton_content"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical"
        android:paddingStart="16dp"
        android:paddingEnd="16dp"
        android:paddingTop="12dp">

        <!-- header: tabs + two icons -->
        <LinearLayout android:layout_width="match_parent" android:layout_height="40dp" android:gravity="center_vertical" android:orientation="horizontal">
            <View android:layout_width="72dp" android:layout_height="24dp" android:layout_marginStart="0dp" android:layout_marginTop="0dp" android:background="@drawable/launch_skeleton_block" /><View android:layout_width="96dp" android:layout_height="24dp" android:layout_marginStart="12dp" android:layout_marginTop="0dp" android:background="@drawable/launch_skeleton_block" />
            <View android:layout_width="0dp" android:layout_height="1dp" android:layout_weight="1" />
            <View android:layout_width="24dp" android:layout_height="24dp" android:layout_marginStart="0dp" android:layout_marginTop="0dp" android:background="@drawable/launch_skeleton_block" /><View android:layout_width="24dp" android:layout_height="24dp" android:layout_marginStart="16dp" android:layout_marginTop="0dp" android:background="@drawable/launch_skeleton_block" />
        </LinearLayout>

        <!-- featured world -->
        <View android:layout_width="match_parent" android:layout_height="240dp" android:layout_marginTop="16dp" android:background="@drawable/launch_skeleton_card" />

        <!-- category chips -->
        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="20dp" android:orientation="horizontal">
            <View android:layout_width="84dp" android:layout_height="32dp" android:layout_marginStart="0dp" android:layout_marginTop="0dp" android:background="@drawable/launch_skeleton_block" /><View android:layout_width="92dp" android:layout_height="32dp" android:layout_marginStart="8dp" android:layout_marginTop="0dp" android:background="@drawable/launch_skeleton_block" /><View android:layout_width="96dp" android:layout_height="32dp" android:layout_marginStart="8dp" android:layout_marginTop="0dp" android:background="@drawable/launch_skeleton_block" />
        </LinearLayout>
        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="8dp" android:orientation="horizontal">
            <View android:layout_width="96dp" android:layout_height="32dp" android:layout_marginStart="0dp" android:layout_marginTop="0dp" android:background="@drawable/launch_skeleton_block" /><View android:layout_width="56dp" android:layout_height="32dp" android:layout_marginStart="8dp" android:layout_marginTop="0dp" android:background="@drawable/launch_skeleton_block" /><View android:layout_width="72dp" android:layout_height="32dp" android:layout_marginStart="8dp" android:layout_marginTop="0dp" android:background="@drawable/launch_skeleton_block" /><View android:layout_width="104dp" android:layout_height="32dp" android:layout_marginStart="8dp" android:layout_marginTop="0dp" android:background="@drawable/launch_skeleton_block" />
        </LinearLayout>

        <!-- section title -->
        <View android:layout_width="120dp" android:layout_height="16dp" android:layout_marginStart="0dp" android:layout_marginTop="24dp" android:background="@drawable/launch_skeleton_block" />

        <!-- card row -->
        <LinearLayout android:layout_width="match_parent" android:layout_height="180dp" android:layout_marginTop="12dp" android:orientation="horizontal">
            <View android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1" android:background="@drawable/launch_skeleton_card" />
            <View android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1" android:layout_marginStart="12dp" android:background="@drawable/launch_skeleton_card" />
        </LinearLayout>
    </LinearLayout>
</FrameLayout>
